# Auto detect text files and perform LF normalization
* text=auto

# Source-inspection tests compare reviewed TypeScript bytes and markers across
# platforms. Keep them deterministic instead of accepting Git's Windows CRLF
# checkout conversion.
*.ts text eol=lf
*.tsx text eol=lf

# Shell scripts must always be LF — CRLF breaks the shebang line on
# Linux ("bad interpreter: /bin/bash\r: No such file or directory"),
# which silently fails the .deb / .rpm postinst hook (#395).
*.sh text eol=lf

# These artifacts participate in byte-for-byte contract hashing and must stay
# identical on Windows, macOS, and Linux checkouts.
contracts/agentera-cloud.openapi.yaml text eol=lf
contracts/experience-candidate-v1-vectors.json text eol=lf
src/shared/agentera-cloud-api.generated.ts text eol=lf

# Vitest imports these CLI modules directly; keep their hashbang lines parseable
# when Windows Git is configured to convert text files to CRLF.
scripts/prepare-agentera-runtime-seed.mjs text eol=lf
scripts/verify-packaged-runtime-seed.mjs text eol=lf
