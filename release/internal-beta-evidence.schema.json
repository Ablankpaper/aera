          "const": "passed"
        },
        "uninstallReinstall": {
          "const": "passed"
        },
        "windowsInstall": {
          "const": "passed"
        }
      },
      "required": [
        "httpsHealth",
        "cloudHealth",
        "adminPrivateHealth",
        "directRegistration",
        "registrationRecoveryUnavailable",
        "login",
        "offlineEntitlement",
        "offlineBoundedUse",
        "invalidOfflineIssuerRejected",
        "invalidOfflineKeyRejected",
        "invalidOfflineSignatureRejected",
        "invalidOfflineBindingRejected",
        "macosInstall",
        "windowsInstall",
        "officialAgentInstall",
        "officialAgentTurn",
        "qualityOffNoUpload",
        "qualityOnFixedCodeOnly",
        "encryptedBackupCreate",
        "backupInterruptedResume",
        "secondDeviceRestore",
        "backupTamperRejected",
        "backupWrongPhraseRejected",
        "backupRevokedDeviceRejected",
        "appRestart",
        "signOutSignIn",
        "uninstallReinstall"
      ],
      "type": "object"
    },
    "packages": {
      "items": {
        "$ref": "#/$defs/package"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "platforms": {
      "items": {
        "$ref": "#/$defs/platform"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "additionalProperties": false,
      "properties": {
        "admin": {
          "$ref": "#/$defs/adminSource"
        },
        "cloud": {
          "$ref": "#/$defs/cloudSource"
        },
        "desktop": {
          "$ref": "#/$defs/desktopSource"
        },
        "runtime": {
          "$ref": "#/$defs/runtimeSource"
        }
      },
      "required": ["desktop", "cloud", "admin", "runtime"],
      "type": "object"
    },
    "status": {
