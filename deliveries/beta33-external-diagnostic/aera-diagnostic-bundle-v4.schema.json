{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aera-diagnostic-bundle-v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectorVersion",
    "captureId",
    "target",
    "startedAt",
    "endedAt",
    "sections",
    "missingEvidence",
    "files",
    "redaction"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "collectorVersion": { "type": "string", "minLength": 1 },
    "captureId": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$"
    },
    "target": { "$ref": "aera-diagnostic-target-v1.schema.json" },
    "startedAt": { "type": "string", "format": "date-time" },
    "endedAt": { "type": "string", "format": "date-time" },
    "platform": { "enum": ["darwin", "win32"] },
    "mode": { "enum": ["external", "internal"] },
    "finishReason": { "type": "string" },
    "reproductionConfirmed": { "type": "boolean" },
    "processContinuityConfirmed": { "type": "boolean" },
    "internal_stage_visibility": { "const": "external_only" },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "finalScan",
        "replacements",
        "dropped",
        "truncated"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "finalScan": { "const": "passed" },
        "replacements": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "integer", "minimum": 0 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 31,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason"],
        "properties": {
          "name": {
            "enum": [
              "target",
              "process",
              "pid_continuity",
              "network",
              "dns_routes",
              "open_files",
              "signature",
              "quarantine",
              "environment",
              "native_abi",
              "runtime_logs",
              "unified_log",
              "platform_events",
              "database",
              "journal",
              "model_chain",
              "managed_files",
              "backups",
              "model_comparison",
              "route_catalog",
              "owner",
              "cloud_origin",
              "main_events",
              "preload_events",
              "renderer_events",
              "runtime_events",
              "owner_events",
              "updater_events",
              "updater",
              "main_renderer_ipc",
              "redaction"
            ]
          },
          "status": { "enum": ["collected", "missing", "failed"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "missingEvidence": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  }
}
