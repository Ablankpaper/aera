.DS_Store
.idea/

# Dependencies
node_modules/

# Build output
dist/
out/

# Browser test artifacts may include local callback URLs and captured pages
test-results/
playwright-report/
blob-report/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# ESLint cache
.eslintcache

# Local LAT semantic index
lat.md/.cache/

# Local isolated Hermes homes for development/tests
.sandbox/

# Electron packaging artifacts; keep the release evidence contract in source.
/release/*
!/release/evidence.schema.json
!/release/internal-beta-evidence.schema.json
.claude/worktrees
.worktrees/

# Verified Runtime Seed build staging (the signed assets are fetched per target)
/resources/agentera-runtime-seed/*
!/resources/agentera-runtime-seed/.gitkeep

# Tauri
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/WixTools/

# Local launcher scripts (user-specific, do not commit)
/*.bat
/*.ps1
.mcp.json
